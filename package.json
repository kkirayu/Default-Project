{
  "name": "dompet-keluarga",
  "version": "1.0.0",
  "private": true,
  "description": "Dompet Keluarga - monolith family finance app (Express + SQLite + React + antd-mobile)",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"node --watch server/index.js\" \"vite\"",
